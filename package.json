{
  "name": "skillora-web",
  "version": "0.1.0",
  "private": true,
  "description": "Skillora frontend — Next.js migration of the standalone HTML prototype.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/upload-validation-contracts.mjs --check",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:journey": "vitest run --config vitest.journey.config.mts",
    "test:journey:browser": "playwright test --config playwright.journey.config.ts",
    "test:profile:browser": "playwright test --config playwright.profile.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "compare": "node scripts/compare-screens.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.5",
    "country-flag-icons": "^1.6.20",
    "immer": "^11.1.21",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
