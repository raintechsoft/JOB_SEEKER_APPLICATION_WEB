# Skillora web — copy to .env.local. Never put secrets in NEXT_PUBLIC_*.

# --- Core ---
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DATA_SOURCE=http
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
API_SESSION_COOKIE=skillora_session
FRONTEND_URL=http://localhost:3000

# --- Product feature flags (set true only when releasing that surface) ---
NEXT_PUBLIC_CAREER_JOURNEY_ENABLED=false
NEXT_PUBLIC_APPLICATION_WIZARD_ENABLED=false
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# --- Disabled until ready to ship again ---
NEXT_PUBLIC_PORTFOLIO_UI_ENABLED=false
NEXT_PUBLIC_COMPARE_CANDIDATES_ENABLED=false
NEXT_PUBLIC_RECRUITER_INVITES_ENABLED=false
NEXT_PUBLIC_TEAM_WORKSPACE_ACCESS_ENABLED=false
NEXT_PUBLIC_JOB_TEMPLATE_CREATE_ENABLED=false
NEXT_PUBLIC_RESPONSE_KEYWORD_MATCHING_ENABLED=false

# --- Realtime (public key only; must match API REALTIME_* / Reverb) ---
NEXT_PUBLIC_REALTIME_ENABLED=false
NEXT_PUBLIC_REALTIME_KEY=
NEXT_PUBLIC_REALTIME_HOST=localhost
NEXT_PUBLIC_REALTIME_PORT=8081
NEXT_PUBLIC_REALTIME_SCHEME=http

# --- Future: analytics (Phase 8) — keep false until approved ---
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_LOCAL_STAGING_REHEARSAL=false
