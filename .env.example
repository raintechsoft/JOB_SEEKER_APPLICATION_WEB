# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time: rebuild after changes.

# development = show demo logins, admin demo, on-screen OTP codes, reset/simulation controls and demo notices.
# production  = hide them (the default when unset).
NEXT_PUBLIC_APP_ENV=development

# mock = browser-local demo backend; http is reserved for the future API.
NEXT_PUBLIC_DATA_SOURCE=mock
# NEXT_PUBLIC_API_BASE_URL=
