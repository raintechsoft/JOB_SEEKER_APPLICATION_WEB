{
  "version": 1,
  "phase": "G2",
  "live": false,
  "home": "/",
  "feedPath": "/",
  "searchPath": "/search",
  "entryPath": "/feed/{entry}",
  "feedFilters": [
    "all",
    "posts",
    "jobs",
    "updates"
  ],
  "searchScopes": [
    "all",
    "posts",
    "companies",
    "people",
    "jobs",
    "updates"
  ],
  "searchSorts": [
    "relevance",
    "recent",
    "salary_asc",
    "salary_desc"
  ],
  "limits": {
    "defaultPageSize": 20,
    "pageSize": 40,
    "commentPageSize": 50,
    "cursor": 4096,
    "returnPath": 4096,
    "queryMin": 2,
    "queryMax": 200,
    "title": 150,
    "body": 20000,
    "comment": 1000,
    "media": 200
  },
  "intentTtlSeconds": 900,
  "cursorPattern": "^[A-Za-z0-9+/_=.-]+$",
  "externalVideoUrlPattern": "^https://(?!(?:[^/]+\\.)?(?:local|localhost|internal|test|invalid|example)/)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}/[^\\x00-\\x20\\x7f\\\\?#]*\\.(?:[mM][pP]4|[wW][eE][bB][mM])$",
  "publicActions": [
    "browse",
    "search",
    "read_entry",
    "read_comments",
    "view_profile",
    "view_job",
    "view_portfolio"
  ],
  "accountActions": [
