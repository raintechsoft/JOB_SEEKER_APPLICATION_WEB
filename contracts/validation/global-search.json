{
  "minimum": 2,
  "maximum": 200,
  "debounceMs": 300,
  "relatedLimit": 6,
  "scopes": ["all", "posts", "companies", "people", "jobs", "updates", "talent", "skills", "projects"],
  "recruiterOnly": ["talent", "skills", "projects"],
  "selectionKinds": {
    "all": ["person", "company", "post", "job", "update", "talent", "project"],
    "posts": ["post"], "companies": ["company"], "people": ["person"], "jobs": ["job"],
    "updates": ["update"], "talent": ["talent"], "skills": ["talent"], "projects": ["project"]
  },
  "filters": {
    "all": [],
    "posts": ["days", "contentType"],
    "companies": ["industry", "location", "companyType"],
    "people": ["location"],
    "jobs": ["location", "skill", "arrangement", "employment", "experienceMin", "experienceMax", "days"],
    "updates": ["days", "author"],
    "talent": ["location", "skill", "experienceMin", "experienceMax"],
    "skills": ["location", "experienceMin", "experienceMax"],
    "projects": ["skill", "discipline", "days"]
  },
  "arrangements": ["On-site", "Hybrid", "Remote"],
  "employment": ["Full-time", "Part-time", "Contract", "Internship"],
  "disciplines": ["Design", "Engineering", "Data", "Business"],
  "contentTypes": ["text", "image", "video", "project"],
  "companyTypes": ["Privately held", "Public company", "Nonprofit", "Government", "Partnership", "Self-employed", "Other"]
}
