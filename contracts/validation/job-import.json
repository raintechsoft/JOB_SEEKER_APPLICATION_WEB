{
  "schemaVersion": 1,
  "activationPhase": "J5",
  "enabledByDefault": false,
  "extensions": ["xlsx"],
  "maxBytes": 10485760,
  "maxExpandedBytes": 104857600,
  "maxArchiveEntries": 5000,
  "maxRows": 5000,
  "maxColumns": 100,
  "maxSheets": 20,
  "maxPositions": 10000,
  "selectionMax": 100,
  "headerRowMax": 100,
  "sourcePositionKeyMax": 100,
  "reviewNoteMax": 2000,
  "presets": ["skillora", "tn-government-research"],
  "mappingTargets": ["sourceId", "employer", "title", "vacancies", "location", "sourceStatus", "date", "dateCaution", "eligibility", "age", "compensation", "sourceApplicationMethod", "sourceFee", "sourceUrl", "noticeUrl", "additionalUrls", "verification", "secondaryUrl", "selection", "documents"],
  "issueCodes": ["missing_fields", "unconfirmed", "expired", "not_open", "ambiguous_deadline", "conflicting_location", "combined_positions", "ambiguous_compensation", "possible_duplicate", "invalid_values"],
  "resolutionKinds": ["confirmed", "corrected", "not_applicable", "skip"],
  "batchStates": ["inspecting", "awaiting_mapping", "parsing", "review", "creating_drafts", "completed", "failed", "cancelled"],
  "positionStates": ["needs_review", "ready_for_draft", "draft_created", "skipped", "failed"],
  "defaultMasterSheet": "All researched entries",
  "clientWritableOwnership": false,
  "externalApplicationRedirects": false,
  "automaticPublication": false
}
